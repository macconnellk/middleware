// Middleware v2.2 (2026-09-30): status line adds Target was/now and a basis tag (MW v2.2; values pre-AutoISF).
// Middleware v2.1 (2026-09-30): status line reports the override-scaled ISF/CR/max IOB the native block applies.
// Middleware v2.0 (2026-09-29): override handling removed; native iAPS owns overrides.
// Sleep mode still raises an override target overnight (stacked, as before v2.0).
function middleware(iob, currenttemp, glucose, profile, autosens, meal, reservoir, clock) {

// DECLARE NOW IMMEDIATELY - before any other code
var now = new Date();

// Define utility functions
function round_basal(basal) {
    var lowest_rate_scale = 20;
    var rounded_basal = basal;
    if (basal < 1) {
        rounded_basal = Math.round(basal * lowest_rate_scale) / lowest_rate_scale;
    }
    else if (basal < 10) {
        rounded_basal = Math.round(basal * 20) / 20;
    }
    else {
        rounded_basal = Math.round(basal * 10) / 10;
    }
    return rounded_basal;
}

function round(value, digits) {
    if (! digits) { digits = 0; }
    var scale = Math.pow(10, digits);
    return Math.round(value * scale) / scale;
}

// **************** CONFIGURATION ****************
var CONFIG = {
    // Main feature toggle
    enableMiddleware: true,

    // Sleep Mode
    sleepMode: {
        startHour: 21,
        endHour: 3,
        bgThreshold: 140,
        targetIncrease: 10,
        hypoTargetIncrease: 40,
        hypoIOBThreshold: 0.1
    }
};

// **************** UTILITY FUNCTIONS ****************

function isTimeInWindow(currentTime, startHour, endHour) {
    var start = new Date(currentTime);
    start.setHours(startHour, 0, 0, 0);
    var end = new Date(currentTime);
    end.setHours(endHour, 0, 0, 0);

    return ((currentTime >= start && currentTime <= end) ||
            (currentTime <= start && currentTime <= end && start > end) ||
            (currentTime >= start && currentTime >= end && start > end));
}

// **************** SLEEP MODE ****************

function applySleepMode(currentTime, currentBG, iob, profile, target) {
    var sleepModeStatus = "";

    if (isTimeInWindow(currentTime, CONFIG.sleepMode.startHour, CONFIG.sleepMode.endHour) &&
        currentBG <= CONFIG.sleepMode.bgThreshold) {

        // Turn off SMBs and raise target by 10
        profile.enableUAM = false;
        profile.enableSMB_always = false;
        profile.enableSMB_with_COB = false;
        profile.enableSMB_after_carbs = false;
        profile.enableSMB_with_temptarget = false;
        profile.enableSMB_high_bg = false;
        var newTarget = target + CONFIG.sleepMode.targetIncrease;
        sleepModeStatus = "SLEEP MODE ON";

        // Check for negative IOB (graduated hypo protection)
        if (iob <= CONFIG.sleepMode.hypoIOBThreshold) {
            newTarget = newTarget + CONFIG.sleepMode.hypoTargetIncrease; // Add 40 MORE (total +50)

            // Graduated basal factor based on IOB level and current BG
            var basalFactor;

            if (currentBG > 140) {
                basalFactor = 0.95;
                sleepModeStatus = "SLEEP MODE ON; NEGATIVE BASAL MODE ON (Recovery)";
            } else if (iob <= -0.2) {
                basalFactor = 0.6;
                sleepModeStatus = "SLEEP MODE ON; NEGATIVE BASAL MODE ON (Severe)";
            } else if (iob <= -0.1) {
                basalFactor = 0.75;
                sleepModeStatus = "SLEEP MODE ON; NEGATIVE BASAL MODE ON (Moderate)";
            } else if (iob <= -0.05) {
                basalFactor = 0.85;
                sleepModeStatus = "SLEEP MODE ON; NEGATIVE BASAL MODE ON (Mild)";
            } else {
                basalFactor = 0.9;
                sleepModeStatus = "SLEEP MODE ON; NEGATIVE BASAL MODE ON (Light)";
            }

            return {
                status: sleepModeStatus,
                newTarget: newTarget,
                hypoMode: true,
                newBasalFactor: basalFactor
            };
        }

        return { status: sleepModeStatus, newTarget: newTarget, hypoMode: false };
    }

    return { status: sleepModeStatus, newTarget: target, hypoMode: false };
}

// **************** MAIN MIDDLEWARE FUNCTION ****************

// Safety check for glucose array
if (!glucose || glucose.length < 4) {
    return "Error: Insufficient glucose data (need at least 4 readings)";
}

// Only proceed if middleware is enabled
if (!CONFIG.enableMiddleware) {
    return "Middleware disabled";
}

// Initialize state variables
var currentBG = glucose[0].glucose;
var target = profile.min_bg;
var scheduledTarget = profile.min_bg; // profile or temp target before sleep mode and overrides; reporting only
var initialISF = profile.sens;
var initialCR = profile.carb_ratio;
var initialCSF = initialISF / initialCR;
// ISF/CR as prepare/profile.js left them; used to back-compute the carb floor for
// reporting. Kept separate from initialISF/initialCR so the floor report is unaffected
// by any later adjustment to the working values.
var reportISF = profile.sens;
var reportCR = profile.carb_ratio;
var currentBasal = profile.current_basal;
var oldBasal = currentBasal;
var iobValue = iob[0].iob;
var past2hoursAverage = profile.dynamicVariables.past2hoursAverage;
var average_total_data = profile.dynamicVariables.average_total_data;

// Initialize log variables
var logSleepMode = "";

var clampNote = "";
if (meal && typeof meal.mealCOB === "number" && typeof meal.orefMealCOB === "number" && meal.orefMealCOB > meal.mealCOB) {
    clampNote = " | COB held " + meal.orefMealCOB + "→" + meal.mealCOB + " (" + (meal.cobClampDecision || "?") + ")";
}

// **************** PROFILE OVERRIDES ****************
// Overrides are applied natively in prepare/determine-basal.js after this middleware
// returns: basal in prepare/middleware.js, ISF/CR/target/SMB/max IOB in the
// dynamicVariables.useOverride block. Never write useOverride or overridePercentage: a reset
// would skip that block. The one permitted write is overrideTarget, in the sleep-mode section.
var logOverride = (profile.dynamicVariables && profile.dynamicVariables.useOverride) ? "On" : "Off";

// Initialize working variables AFTER profile overrides
var newISF = initialISF;
var newCR = initialCR;
var hypoMode = false;

// **************** APPLY SLEEP MODE ****************
// With an override target active (and no temp target), the sleep-mode raise stacks on the
// override target, as it did before v2.0. The native block in prepare/determine-basal.js
// writes min_bg/max_bg from dynamicVariables.overrideTarget, so the raised value is written
// there; Auto ISF reads the same field. This is the only dynamicVariables write allowed here.
var dv = profile.dynamicVariables || {};
var overrideTargetActive = dv.useOverride === true && typeof dv.overrideTarget === "number" &&
    dv.overrideTarget >= 80 && !profile.temptargetSet;
var sleepBaseTarget = overrideTargetActive ? dv.overrideTarget : target;
var sleepMode = applySleepMode(now, currentBG, iobValue, profile, sleepBaseTarget);
logSleepMode = sleepMode.status;
if (sleepMode.status !== "") {
    target = sleepMode.newTarget;
    if (overrideTargetActive) {
        profile.dynamicVariables.overrideTarget = target;
    }
}

// Handle hypo mode from sleep mode
if (sleepMode.hypoMode) {
    currentBasal = round(currentBasal * sleepMode.newBasalFactor, 2);
    newISF = round(initialISF / 0.95, 0); // Stronger ISF (divide by 0.95)
    newCR = round(initialCR / 0.95, 2); // Stronger CR (divide by 0.95)
    hypoMode = true;
}

// Calculate CSF
var checkCSF = 0;
if (newCR > 0 && newISF > 0) {
    checkCSF = newISF / newCR;
} else {
    checkCSF = initialCSF;
}

// **************** SET PROFILE VALUES ****************
profile.current_basal = currentBasal;
profile.sens = newISF;
profile.carb_ratio = newCR;
profile.min_bg = target;
profile.max_bg = target;
profile.target_bg = target;

// **************** CARB FLOOR (REPORTING ONLY) ****************
// min_5m_carbimpact is derived in prepare/profile.js from the preference read as
// grams per hour, and meal.js consumed it several steps before this middleware runs.
// Recomputing here would have no effect and would report a figure not in force.
// Back-computes the applied floor using the ISF/CR prepare/profile.js used:
//   g/hr = min_5m_carbimpact * CR / ISF * 12
var carbFloorGramsPerHour = (reportISF > 0 && reportCR > 0)
    ? profile.min_5m_carbimpact * reportCR / reportISF * 12
    : 0;

// **************** REPORTED VALUES (DISPLAY ONLY) ****************
// The native override block in prepare/determine-basal.js scales ISF, CR and max IOB after this
// middleware returns, while prepare/middleware.js has already scaled basal before it runs. To
// report every field on one basis, "was" is the scheduled profile value and "now" is the value
// after this middleware and the native override, using the native block's own rules. Auto ISF
// and dynamic ISF are applied later still and are not included; oref's reason fields carry them.
var dvReport = profile.dynamicVariables || {};
var reportFactor = (dvReport.useOverride && dvReport.overridePercentage > 0) ? dvReport.overridePercentage / 100 : 1;
var reportScalesISF = reportFactor !== 1 && (dvReport.isfAndCr || dvReport.isf);
var reportScalesCR = reportFactor !== 1 && (dvReport.isfAndCr || dvReport.cr);
var effectiveISF = reportScalesISF ? profile.sens / reportFactor : profile.sens;
var effectiveCR = reportScalesCR ? round(profile.carb_ratio / reportFactor, 1) : profile.carb_ratio;
var effectiveCSF = (effectiveCR > 0 && effectiveISF > 0) ? effectiveISF / effectiveCR : checkCSF;
var effectiveMaxIOB = (dvReport.useOverride && dvReport.advancedSettings && dvReport.overrideMaxIOB)
    ? dvReport.maxIOB : profile.max_iob;
var scheduledBasal = (typeof profile.old_basal === "number") ? profile.old_basal : oldBasal;
// Target oref will use: the native block replaces min_bg with overrideTarget (already raised by
// sleep mode above, when active) unless a temp target is set. Same rule as prepare/determine-basal.js.
var effectiveTarget = (dvReport.useOverride && dvReport.overrideTarget != 0 && dvReport.overrideTarget != 6 && !profile.temptargetSet)
    ? dvReport.overrideTarget : profile.min_bg;

// **************** RETURN DETAILED STATUS ****************
return logSleepMode +
       ". Override " + logOverride +
       ". ISF was/now " + round(initialISF, 2) + "/" + round(effectiveISF, 2) +
       " Basal was/now " + scheduledBasal + "/" + profile.current_basal +
       ". CR was/now " + initialCR + "/" + round(effectiveCR, 2) +
       " CSF was/now " + round(initialCSF, 2) + "/" + round(effectiveCSF, 2) +
       ". Target was/now " + round(scheduledTarget, 0) + "/" + round(effectiveTarget, 0) +
       ". Max IOB " + round(effectiveMaxIOB, 2) +
       ". Carb floor " + round(carbFloorGramsPerHour, 1) + " g/hr (impact " + profile.min_5m_carbimpact +
       " ISF " + round(reportISF, 0) + " CR " + round(reportCR, 1) + ")" +
       ". TDD " + round(past2hoursAverage, 2) + " 2week TDD " + round(average_total_data, 2) +
       clampNote +
       " | MW v2.2 values pre-AutoISF";

}
